namespace EventManager

features
	EventManager
		mandatory
			Report
				optional
					PriorityReport
			Review
				optional
					AnonymousReview
			CheckIn {abstract true}
				alternative
					ManualCheckIn
					TicketCheckIn
					TimeStampCheckIn
			EventCreation
				optional
					TypeEventCreation
			AttendeeManagement
				optional
					ClassAttendeeManagement
		optional
			TicketingSystem
			Payment
				or
					QRIS
					BankTransfer
			Notification
				optional
					TargetedNotification

constraints
	TicketCheckIn => TicketingSystem
