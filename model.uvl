namespace EventManager

features
	EventManager
		mandatory
			Report
				optional
					PriorityReport
			Review
				optional
					AnonymousReview
			CheckIn {abstract true}
				optional
					TimeStampCheckIn
			EventCreation
				optional
					TypeEventCreation
			AttendeeManagement
				optional
					ClassAttendeeManagement
			Notification
				optional
					TargetedNotification

